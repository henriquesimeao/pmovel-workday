# Copie para .env e preencha com os dados do tenant do cliente.
# Guia completo: docs/workday-novo-cliente.md

# Nome do tenant (último segmento da URL do Workday)
WorkdayTenant=meutenant_impl
# URL de acesso ao Workday (UI)
WorkdayTenantUrl=https://xxxx.wdNNN.myworkday.com/meutenant_impl
# Opcional: host dos serviços, se não seguir o padrão <prefixo>-services1.<resto>
# WorkdayServicesUrl=https://xxxx-services1.wdNNN.myworkday.com

# API Client for Integrations registrado NO TENANT (não usar os do developer.workday.com)
WorkdayClientId=
WorkdayClientSecret=
# Refresh token gerado para o ISU em "Manage Refresh Tokens for Integrations"
WorkdayRefreshToken=
