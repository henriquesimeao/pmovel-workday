# Copie para .env e preencha. Carregado via `node --env-file=.env` (scripts npm).
# Guia de configuração do tenant Workday: docs/workday-novo-cliente.md

# ---------------------------------------------------------------------------
# Ambiente
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# Workday (origem na Fase 1) — API Client for Integrations registrado NO TENANT
# ---------------------------------------------------------------------------
# Nome do tenant (último segmento da URL do Workday)
WorkdayTenant=meutenant_impl
# URL de acesso ao Workday (UI)
WorkdayTenantUrl=https://xxxx.wdNNN.myworkday.com/meutenant_impl
# Opcional: host dos serviços, se não seguir o padrão <prefixo>-services1.<resto>
# WorkdayServicesUrl=https://xxxx-services1.wdNNN.myworkday.com
WorkdayClientId=
WorkdayClientSecret=
# Refresh token gerado para o ISU em "Manage Refresh Tokens for Integrations"
WorkdayRefreshToken=

# ---------------------------------------------------------------------------
# Pmovel (destino na Fase 1) — credenciais da API tools.pmovel.com.br
# ---------------------------------------------------------------------------
PmovelBaseUrl=https://tools.pmovel.com.br
# Enviados em POST /v3/auth/login para obter o JWT (access_token)
PmovelAccessKeyId=
PmovelSecretAccessKey=

# ---------------------------------------------------------------------------
# Banco de dados (MySQL) — estado das sincronizações, de/para CNPJ, cursores
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pmovel_workday_integration

# ---------------------------------------------------------------------------
# Sincronização
# ---------------------------------------------------------------------------
# Cron do disparo agendado (formato @nestjs/schedule). Default: a cada hora.
SYNC_CRON=0 * * * *
# Habilita o disparo agendado (o disparo sob demanda via HTTP está sempre ativo).
SYNC_SCHEDULE_ENABLED=false
